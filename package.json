{
  "name": "katakata",
  "version": "0.9.0",
  "private": true,
  "description": "Kata-Kata: offline Malay word trainer for Japanese learners",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:check": "node tools/check-content.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "bridge:import": "python3 -I tools/import_hanashishou_bridge.py ../hanashishou"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
