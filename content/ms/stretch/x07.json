  "scenario": {
    "title_en": "Arriving at the airport",
    "title_ja": "空港に着いて",
    "lines": [
      {
        "id": "ms-x07-d01",
        "speaker": "Encik Rahman",
        "ms": "Encik Tanaka, penerbangan Encik tiba pukul berapa?",
        "en": "Mr Tanaka, what time does your flight arrive?"
      },
      {
        "id": "ms-x07-d02",
        "speaker": "Tanaka",
        "ms": "Penerbangan saya tiba pukul lapan malam, di Terminal 1.",
        "en": "My flight arrives at eight in the evening, at Terminal 1.",
        "choices": [
          "Penerbangan saya tiba di perpustakaan.",
          "Saya pandu kereta ke pejabat."
        ],
        "choices_en": [
          "My flight arrives at the library.",
          "I drive to the office."
        ]
      },
      {
        "id": "ms-x07-d03",
        "speaker": "Encik Rahman",
        "ms": "Saya tunggu Encik di luar, selepas kastam.",
        "en": "I'll wait for you outside, after customs."
      },
      {
        "id": "ms-x07-d04",
        "speaker": "Tanaka",
        "ms": "Terima kasih, Encik. Bagasi saya besar dan berat!",
        "en": "Thank you. My luggage is big and heavy!",
        "choices": [
          "Terima kasih. Saya tunggu Encik di perpustakaan.",
          "Maaf, saya tidak pandu kereta."
        ],
        "choices_en": [
          "Thank you. I'll wait for you at the library.",
          "Sorry, I don't drive."
        ]
      },
      {
        "id": "ms-x07-d05",
        "speaker": "(Narrator)",
