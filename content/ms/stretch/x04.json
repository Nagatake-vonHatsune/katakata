  "frames": [
    {
      "id": "ms-x04-f01",
      "frame": "Saya ___ ___ semula selepas ___.",
      "example": "Saya baca buku itu semula selepas makan malam.",
      "meaning_en": "I read that book again after dinner.",
      "meaning_ja": "夕食の後、その本をもう一度読みます。",
      "decoys": [
        "sebelum"
      ]
    },
    {
      "id": "ms-x04-f02",
      "frame": "___ sekali, ___ datang dari ___.",
      "example": "Setahun sekali, keluarga saya datang dari Jepun.",
      "meaning_en": "Once a year, my family comes from Japan.",
      "meaning_ja": "年に一度、家族が日本から来ます。",
      "decoys": [
        "sejam"
      ]
    },
    {
      "id": "ms-x04-f03",
      "frame": "Sekarang sudah hampir pukul ___ dan saya masih ___.",
      "example": "Sekarang sudah hampir pukul sebelas malam dan saya masih di pejabat.",
      "meaning_en": "It's nearly 11 p.m. and I'm still at the office.",
      "meaning_ja": "もうすぐ夜11時ですが、まだ会社にいます。",
      "decoys": [
        "belum"
      ]
    },
    {
      "id": "ms-x04-f04",
      "frame": "___ ___ kerap ___ malam-malam.",
      "example": "Minggu ini dia kerap balik dari pejabat malam-malam.",
      "meaning_en": "This week he often comes home from the office late at night.",
      "meaning_ja": "今週、彼はよく夜遅くに会社から帰ります。",
      "decoys": [
        "jarang"
      ]
    },
    {
      "id": "ms-x04-f05",
      "frame": "Boleh ___ ulang sekali lagi? Saya belum ___.",
      "example": "Boleh Encik ulang sekali lagi? Saya belum faham.",
      "meaning_en": "Could you say it once more? I don't understand yet.",
      "meaning_ja": "もう一度言っていただけますか。まだわかりません。",
      "decoys": [
        "sudah"
      ]
    },
    {
      "id": "ms-x04-f06",
      "frame": "___ ___ saya akan beri ___ ___.",
      "example": "Esok pagi saya akan beri Encik jadual baru.",
      "meaning_en": "Tomorrow morning I'll give you the new schedule.",
      "meaning_ja": "明日の朝、新しい予定表をお渡しします。",
      "decoys": [
        "semalam"
      ]
    }
  ],
  "scenario": {
    "title_en": "An early start",
    "title_ja": "朝早い一日",
    "lines": [
      {
        "id": "ms-x04-d01",
        "speaker": "Puan Aini",
        "ms": "Selamat pagi, Encik Tanaka. Encik datang awal hari ini!",
        "en": "Good morning, Mr Tanaka. You're early today!"
      },
      {
        "id": "ms-x04-d02",
        "speaker": "Tanaka",
        "ms": "Selamat pagi, Puan. Ya, saya bangun pagi-pagi. Mesyuarat mula pukul berapa?",
        "en": "Good morning. Yes, I got up early. What time does the meeting start?",
        "choices": [
          "Selamat malam, Puan. Saya baru bangun.",
          "Selamat pagi, Puan. Saya datang lambat hari ini."
        ],
        "choices_en": [
          "Good evening. I've only just got up.",
          "Good morning. I came late today."
        ]
      },
      {
        "id": "ms-x04-d03",
        "speaker": "Puan Aini",
        "ms": "Pukul sembilan. Sekarang sudah hampir pukul lapan setengah.",
        "en": "At nine. It's nearly half past eight now."
      },
      {
        "id": "ms-x04-d04",
        "speaker": "Tanaka",
        "ms": "Baik. Boleh saya bantu Puan?",
        "en": "Okay. Can I help you?",
        "choices": [
          "Baik. Saya tidur dulu.",
          "Baik. Mesyuarat sudah habis semalam."
        ],
        "choices_en": [
          "Okay. I'll sleep first.",
          "Okay. The meeting finished yesterday."
        ]
      },
      {
        "id": "ms-x04-d05",
        "speaker": "Puan Aini",
        "ms": "Terima kasih. Boleh Encik cetak jadual ini?",
        "en": "Thank you. Could you print this schedule?"
      },
      {
        "id": "ms-x04-d06",
        "speaker": "Tanaka",
        "ms": "Boleh. Saya cetak sekarang.",
        "en": "Sure. I'll print it now.",
        "choices": [
          "Boleh. Saya cetak tahun depan.",
          "Belum. Saya sudah cetak semalam."
        ],
        "choices_en": [
          "Sure. I'll print it next year.",
          "Not yet. I printed it yesterday."
        ]
      },
      {
        "id": "ms-x04-d07",
        "speaker": "Puan Aini",
        "ms": "Encik Rahman datang lambat hari ini. Dia akan sampai pukul sembilan suku.",
        "en": "Mr Rahman is coming late today. He'll arrive at a quarter past nine."
      },
      {
        "id": "ms-x04-d08",
        "speaker": "Tanaka",
        "ms": "Baik, kita tunggu dia sekejap.",
        "en": "Okay, we'll wait for him a moment."
      },
      {
        "id": "ms-x04-d09",
        "speaker": "Puan Aini",
        "ms": "Ya. Selepas mesyuarat, saya mula cuti tahunan.",
        "en": "Yes. After the meeting, my annual leave starts."
      },
      {
        "id": "ms-x04-d10",
        "speaker": "Tanaka",
        "ms": "Wah, seronok! Percutian di mana?",
        "en": "Wow, nice! Where's the holiday?",
        "choices": [
          "Wah, seronok! Mesyuarat di mana?",
          "Wah, seronok! Puan selalu datang lambat."
        ],
        "choices_en": [
          "Wow, nice! Where's the meeting?",
          "Wow, nice! You always come late."
        ]
      },
      {
        "id": "ms-x04-d11",
        "speaker": "Puan Aini",
        "ms": "Di pantai, dengan keluarga saya. Kami pergi setahun sekali.",
        "en": "At the beach, with my family. We go once a year."
      },
      {
        "id": "ms-x04-d12",
        "speaker": "Tanaka",
        "ms": "Sekarang musim hujan. Bawa payung, Puan!",
        "en": "It's the rainy season now. Take an umbrella!"
      },
      {
        "id": "ms-x04-d13",
        "speaker": "Encik Rahman",
        "ms": "Maaf, saya lambat! Jom, kita mula sekarang.",
        "en": "Sorry I'm late! Come on, let's start now."
      },
      {
        "id": "ms-x04-d14",
        "speaker": "Tanaka",
        "ms": "Baik, Encik. Saya sudah cetak jadual mesyuarat.",
        "en": "Okay. I've printed the meeting schedule.",
        "choices": [
          "Baik, Encik. Saya akan cetak jadual semalam.",
          "Baik, Encik. Saya belum bangun."
        ],
        "choices_en": [
          "Okay. I will print the schedule yesterday.",
          "Okay. I haven't got up yet."
        ]
      }
    ]
  }
}
