  "scenario": {
    "title_en": "Who did what in the office",
    "title_ja": "オフィスで、誰が何をした？",
    "lines": [
      {
        "id": "ms-c11-s01",
        "speaker": "Tanaka",
        "ms": "Puan Aini, emel dari Jepun itu sudah dibaca?",
        "en": "Puan Aini, has that email from Japan been read yet?"
      },
      {
        "id": "ms-c11-s02",
        "speaker": "Puan Aini",
        "ms": "Sudah. Saya membaca emel itu pagi tadi, kemudian saya menghantar fail itu.",
        "en": "Yes. I read the email this morning, then I sent the file."
      },
      {
        "id": "ms-c11-s03",
        "speaker": "Tanaka",
        "ms": "Oh, Encik Rahman yang menerima fail itu?",
        "en": "Oh, Encik Rahman is the one who received the file?"
      },
      {
        "id": "ms-c11-s04",
        "speaker": "Puan Aini",
        "ms": "Ya. Sekarang dia sedang membuka fail itu.",
        "en": "Yes. He's opening the file now."
      },
      {
        "id": "ms-c11-s05",
        "speaker": "Encik Rahman",
        "ms": "Selamat pagi, Encik Tanaka. Saya sudah membuka fail itu. Sekarang saya sedang menulis jawapan.",
        "en": "Good morning, Mr Tanaka. I've opened the file. Now I'm writing the reply."
      },
      {
        "id": "ms-c11-s06",
        "speaker": "Tanaka",
        "ms": "Baik. Siapa yang akan menelefon pejabat di Jepun?",
        "en": "Good. Who will phone the office in Japan?"
      },
      {
        "id": "ms-c11-s07",
        "speaker": "Encik Rahman",
        "ms": "Saya akan menelefon mereka petang ini.",
        "en": "I'll phone them this afternoon."
      },
      {
        "id": "ms-c11-s08",
        "speaker": "Puan Aini",
        "ms": "Baik, encik. Saya menunggu jawapan itu.",
        "en": "Fine. I'll wait for that answer."
      },
      {
        "id": "ms-c11-s09",
        "speaker": "Tanaka",
        "ms": "Cik Mei Ling, draf slaid itu sudah siap?",
        "en": "Mei Ling, is the slide draft ready?"
      },
      {
        "id": "ms-c11-s10",
        "speaker": "Cik Mei Ling",
        "ms": "Belum. Saya masih menyemak draf itu. Tarikh akhir hari Jumaat, ya?",
        "en": "Not yet. I'm still checking the draft. The deadline is Friday, right?"
      },
      {
        "id": "ms-c11-s11",
        "speaker": "Tanaka",
        "ms": "Ya, hari Jumaat. Saya mengira jumlah itu semalam, tetapi tolong semak sekali lagi.",
        "en": "Yes, Friday. I worked out the total yesterday, but please check it once more."
      },
      {
        "id": "ms-c11-s12",
        "speaker": "Cik Mei Ling",
        "ms": "Baik. Draf itu akan siap petang ini. Nanti saya menghantar mesej.",
        "en": "Fine. The draft will be ready this afternoon. I'll send a message later."
      },
      {
        "id": "ms-c11-s13",
        "speaker": "Tanaka",
        "ms": "Terima kasih. Hujung minggu ini cik buat apa?",
        "en": "Thank you. What are you doing this weekend?"
      },
      {
        "id": "ms-c11-s14",
        "speaker": "Cik Mei Ling",
        "ms": "Saya mahu mendaki dengan kawan saya. Encik pula?",
        "en": "I'm going hiking with a friend. And you?"
      },
      {
        "id": "ms-c11-s15",
        "speaker": "Tanaka",
        "ms": "Saya mahu memasak. Isteri saya mengajar saya memasak nasi lemak.",
        "en": "I want to cook. My wife is teaching me to cook nasi lemak."
      },
      {
        "id": "ms-c11-s16",
        "speaker": "Cik Mei Ling",
        "ms": "Wah, bagus! Boleh saya mengecas telefon saya di sini? Bateri sudah habis.",
        "en": "Wow, great! Can I charge my phone here? The battery's dead."
      },
      {
        "id": "ms-c11-s17",
        "speaker": "Tanaka",
        "ms": "Boleh. Letak telefon itu di atas meja.",
        "en": "Sure. Put the phone on the table."
      },
      {
        "id": "ms-c11-s18",
        "speaker": "Cik Mei Ling",
        "ms": "Terima kasih! Mari kita minum kopi. Saya yang membayar.",
        "en": "Thanks! Let's have coffee. I'm paying."
      }
    ]
  },
