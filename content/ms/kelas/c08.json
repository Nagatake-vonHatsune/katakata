  "scenario": {
    "title_en": "Morning market and takeaway",
    "title_ja": "朝市とテイクアウト",
    "lines": [
      {
        "id": "ms-c08-s01",
        "speaker": "Pak Cik Ali",
        "ms": "Encik mahu apa?",
        "en": "What would you like?"
      },
      {
        "id": "ms-c08-s02",
        "speaker": "Tanaka",
        "ms": "Saya mahu dua ekor ikan dan sepuluh biji telur.",
        "en": "Two fish and ten eggs, please."
      },
      {
        "id": "ms-c08-s03",
        "speaker": "Pak Cik Ali",
        "ms": "Ayam?",
        "en": "Chicken?"
      },
      {
        "id": "ms-c08-s04",
        "speaker": "Tanaka",
        "ms": "Seekor ayam juga. Berapa harga semua?",
        "en": "One chicken too. How much for everything?"
      },
      {
        "id": "ms-c08-s05",
        "speaker": "Pak Cik Ali",
        "ms": "Semua tiga puluh lima ringgit.",
