  "frames": [
    {
      "id": "ms-c16-f01",
      "frame": "Saya tertinggal ___ di ___.",
      "example": "Saya tertinggal telefon di pejabat.",
      "meaning_en": "I left my phone at the office.",
      "meaning_ja": "電話をオフィスに置き忘れました。"
    },
    {
      "id": "ms-c16-f02",
      "frame": "Maaf, saya ___.",
      "example": "Maaf, saya terlupa.",
      "meaning_en": "Sorry, I forgot.",
      "meaning_ja": "すみません、うっかり忘れました。"
    },
    {
      "id": "ms-c16-f03",
      "frame": "___ tertumpah di ___.",
      "example": "Air kopi tertumpah di meja.",
      "meaning_en": "Coffee spilled on the table.",
      "meaning_ja": "コーヒーが机にこぼれました。"
    },
    {
      "id": "ms-c16-f04",
      "frame": "Saya tidak sengaja ___ ___.",
      "example": "Saya tidak sengaja terlanggar kerusi.",
      "meaning_en": "I bumped into the chair by accident.",
      "meaning_ja": "うっかり椅子にぶつかってしまいました。"
    },
    {
      "id": "ms-c16-f05",
      "frame": "Ini ___, tetapi saya ___.",
      "example": "Ini termurah, tetapi saya tertinggal dompet saya.",
      "meaning_en": "This is the cheapest, but I left my wallet behind.",
      "meaning_ja": "これが一番安いですが、財布を置き忘れました。"
    },
    {
      "id": "ms-c16-f06",
      "frame": "Pintu terkunci. Boleh tolong ___?",
      "example": "Pintu terkunci. Boleh tolong hubungi pejabat pengurusan?",
      "meaning_en": "The door is locked. Could you please contact the management office?",
      "meaning_ja": "ドアに鍵がかかってしまいました。管理事務所に連絡してもらえますか。"
    }
  ],
  "scenario": {
    "title_en": "A locked door, a spill and a slip",
    "title_ja": "鍵、こぼれたコーヒー、転倒",
    "lines": [
      {
        "id": "ms-c16-s01",
        "speaker": "Tanaka",
        "ms": "Selamat malam. Maaf, kunci saya tertinggal di dalam rumah. Pintu terkunci.",
        "en": "Good evening. Sorry, my key is left inside the flat. The door is locked."
      },
      {
        "id": "ms-c16-s02",
        "speaker": "Pengawal",
        "ms": "Unit berapa, encik?",
        "en": "Which unit, sir?"
      },
      {
        "id": "ms-c16-s03",
        "speaker": "Tanaka",
        "ms": "Blok B, unit 12-3. Saya terlupa kunci tadi.",
        "en": "Block B, unit 12-3. I forgot the key earlier."
      },
      {
        "id": "ms-c16-s04",
        "speaker": "Pengawal",
        "ms": "Encik tunggu di sini. Saya hubungi pejabat pengurusan.",
        "en": "Please wait here. I'll contact the management office."
      },
      {
        "id": "ms-c16-s05",
        "speaker": "Tanaka",
        "ms": "Baik. Terima kasih banyak.",
        "en": "Okay. Thank you very much."
      },
      {
        "id": "ms-c16-s06",
        "speaker": "Cik Mei Ling",
        "ms": "Maaf, saya lambat. Saya terlepas bas, kemudian saya tersangkut di jalan yang sesak.",
        "en": "Sorry I'm late. I missed the bus, then I got stuck on a congested road."
      },
      {
        "id": "ms-c16-s07",
        "speaker": "Tanaka",
        "ms": "Jangan risau. Mesyuarat belum mula.",
        "en": "Don't worry. The meeting hasn't started."
      },
      {
        "id": "ms-c16-s08",
        "speaker": "Cik Mei Ling",
        "ms": "Maaf, Encik Tanaka! Air kopi saya tertumpah di meja. Cawan saya pun pecah.",
        "en": "Sorry, Mr Tanaka! My coffee spilled on the table. My cup broke too."
      },
      {
        "id": "ms-c16-s09",
        "speaker": "Tanaka",
        "ms": "Awak tidak sengaja. Jangan risau.",
        "en": "You didn't do it on purpose. Don't worry."
      },
      {
        "id": "ms-c16-s10",
        "speaker": "Cik Mei Ling",
        "ms": "Saya ambil tisu. Fail encik sedikit basah.",
        "en": "I'll get tissues. Your file is a little wet."
      },
      {
        "id": "ms-c16-s11",
        "speaker": "Tanaka",
        "ms": "Terima kasih. Hati-hati, lantai licin.",
        "en": "Thank you. Careful, the floor is slippery."
      },
      {
        "id": "ms-c16-s12",
        "speaker": "Tanaka",
        "ms": "Selamat pagi. Saya tergelincir di tangga tadi.",
        "en": "Good morning. I slipped on the stairs earlier."
      },
      {
        "id": "ms-c16-s13",
        "speaker": "Penyambut tetamu",
        "ms": "Encik tercedera? Di mana yang sakit?",
        "en": "Are you hurt? Where does it hurt?"
      },
      {
        "id": "ms-c16-s14",
        "speaker": "Tanaka",
        "ms": "Tangan saya bengkak dan ada luka kecil. Lutut saya pun lebam.",
        "en": "My hand is swollen and there's a small wound. My knee is bruised too."
      },
      {
        "id": "ms-c16-s15",
        "speaker": "Penyambut tetamu",
        "ms": "Encik perlu daftar dulu. Ini borang.",
        "en": "You need to register first. Here is the form."
      },
      {
        "id": "ms-c16-s16",
        "speaker": "Tanaka",
        "ms": "Baik. Boleh doktor melihat tangan saya sekarang?",
        "en": "Okay. Can the doctor look at my hand now?"
      },
      {
        "id": "ms-c16-s17",
        "speaker": "Penyambut tetamu",
        "ms": "Boleh. Sila tunggu sekejap.",
        "en": "Yes. Please wait a moment."
      }
    ]
  },
