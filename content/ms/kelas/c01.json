      "meaning_ja": "お先に失礼します。また明日！"
    }
  ],
  "scenario": {
    "title_en": "First day at the office",
    "title_ja": "会社の初日",
    "lines": [
      {
        "id": "ms-c01-s01",
        "speaker": "Puan Aini",
        "ms": "Selamat pagi! Selamat datang.",
        "en": "Good morning! Welcome."
      },
      {
        "id": "ms-c01-s02",
        "speaker": "Tanaka",
        "ms": "Selamat pagi. Saya Tanaka.",
        "en": "Good morning. I'm Tanaka."
      },
      {
        "id": "ms-c01-s03",
        "speaker": "Puan Aini",
        "ms": "Apa khabar, Encik Tanaka?",
        "en": "How are you, Mr Tanaka?"
      },
      {
        "id": "ms-c01-s04",
        "speaker": "Tanaka",
        "ms": "Khabar baik, terima kasih. Puan pula?",
        "en": "Fine, thank you. And you?"
      },
      {
        "id": "ms-c01-s05",
        "speaker": "Puan Aini",
        "ms": "Baik, terima kasih. Selamat berkenalan.",
        "en": "Fine, thanks. Nice to meet you."
      },
      {
        "id": "ms-c01-s06",
        "speaker": "Tanaka",
        "ms": "Selamat berkenalan.",
        "en": "Nice to meet you."
      },
      {
        "id": "ms-c01-s07",
        "speaker": "(Narrator)",
        "ms": "Petang. (Evening.)",
        "en": "Evening."
      },
      {
        "id": "ms-c01-s08",
        "speaker": "Tanaka",
        "ms": "Puan Aini, saya minta diri dulu.",
        "en": "Mrs Aini, I'll take my leave now."
      },
      {
        "id": "ms-c01-s09",
        "speaker": "Puan Aini",
        "ms": "Baik. Jumpa esok, Encik Tanaka. Selamat jalan!",
        "en": "Okay. See you tomorrow. Safe journey!"
      },
      {
        "id": "ms-c01-s10",
        "speaker": "Tanaka",
        "ms": "Terima kasih. Jumpa esok!",
        "en": "Thank you. See you tomorrow!"
      }
    ]
