  "scenario": {
    "title_en": "Finding the LRT, then a Grab ride",
    "title_ja": "LRTを探して、Grabに乗る",
    "lines": [
      {
        "id": "ms-c07-s01",
        "speaker": "Tanaka",
        "ms": "Maaf, tumpang tanya. Stesen LRT di mana?",
        "en": "Excuse me, where's the LRT station?"
      },
      {
        "id": "ms-c07-s02",
        "speaker": "Kak Siti",
        "ms": "Encik jalan lurus, kemudian belok kanan di lampu isyarat.",
        "en": "Go straight, then turn right at the traffic lights."
      },
      {
        "id": "ms-c07-s03",
        "speaker": "Tanaka",
        "ms": "Jauhkah dari sini?",
        "en": "Is it far from here?"
      },
      {
        "id": "ms-c07-s04",
        "speaker": "Kak Siti",
        "ms": "Tidak jauh. Lebih kurang lima ratus meter. Jalan kaki lebih kurang sepuluh minit.",
        "en": "Not far. About 500 m, about ten minutes on foot."
      },
      {
        "id": "ms-c07-s05",
        "speaker": "Tanaka",
        "ms": "Stesen itu di sebelah bank?",
        "en": "Is the station next to the bank?"
      },
      {
        "id": "ms-c07-s06",
        "speaker": "Kak Siti",
        "ms": "Bukan. Stesen itu di depan bank, di sebelah kedai kopi.",
        "en": "No. It's in front of the bank, next to the coffee shop."
      },
      {
        "id": "ms-c07-s07",
        "speaker": "Tanaka",
        "ms": "Terima kasih banyak!",
        "en": "Thank you very much!"
      },
      {
        "id": "ms-c07-s08",
        "speaker": "Kak Siti",
        "ms": "Sama-sama. Hati-hati!",
        "en": "You're welcome. Take care!"
      },
      {
        "id": "ms-c07-s09",
        "speaker": "(Later, in a Grab)",
        "ms": "Pemandu: Encik mahu pergi ke mana?",
        "en": "Where would you like to go?"
      },
      {
        "id": "ms-c07-s10",
        "speaker": "Tanaka",
        "ms": "Ke Pavilion. Berapa lama?",
        "en": "To Pavilion. How long will it take?"
      },
      {
        "id": "ms-c07-s11",
        "speaker": "Pemandu",
        "ms": "Lebih kurang dua puluh minit, kalau tak jam.",
        "en": "About twenty minutes, if there's no jam."
      },
      {
        "id": "ms-c07-s12",
        "speaker": "Tanaka",
        "ms": "Saya turun di depan pintu masuk, ya.",
        "en": "I'll get off in front of the entrance."
      },
      {
        "id": "ms-c07-s13",
        "speaker": "Pemandu",
        "ms": "Boleh, encik.",
        "en": "Sure."
      }
    ]
  },
