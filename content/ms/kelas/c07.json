  "frames": [
    {
      "id": "ms-c07-f01",
      "frame": "(title) mahu pergi ke mana? / Saya mahu pergi ke ___.",
      "example": "Saya mahu pergi ke stesen.",
      "meaning_en": "I want to go to the station.",
      "meaning_ja": "駅に行きたいです。"
    },
    {
      "id": "ms-c07-f02",
      "frame": "___ di (position) ___.",
      "example": "Stesen itu di depan bank.",
      "meaning_en": "The station is in front of the bank.",
      "meaning_ja": "駅は銀行の前にあります。"
    },
    {
      "id": "ms-c07-f03",
      "frame": "Jalan terus, kemudian belok kiri / kanan di ___.",
      "example": "Jalan terus, kemudian belok kanan di lampu isyarat.",
      "meaning_en": "Go straight on, then turn right at the lights.",
      "meaning_ja": "まっすぐ行って、信号を右に曲がってください。"
    },
    {
      "id": "ms-c07-f04",
      "frame": "Berapa jauh ___ dari sini? / Lebih kurang ___.",
      "example": "Berapa jauh stesen dari sini? Lebih kurang lima ratus meter.",
      "meaning_en": "How far is the station? About 500 m.",
      "meaning_ja": "駅はここからどのくらいですか。約500メートルです。"
    },
    {
      "id": "ms-c07-f05",
      "frame": "Berapa lama ke ___? / Lebih kurang ___ minit naik ___.",
      "example": "Berapa lama ke pejabat? Lebih kurang dua puluh minit naik teksi.",
      "meaning_en": "How long to the office? About 20 minutes by taxi.",
      "meaning_ja": "オフィスまでどのくらいかかりますか。タクシーで約20分です。"
    }
  ],
  "scenario": {
    "title_en": "Finding the station, then a taxi ride",
    "title_ja": "駅を探して、タクシーに乗る",
    "lines": [
      {
        "id": "ms-c07-s01",
        "speaker": "Tanaka",
        "ms": "Maaf, tumpang tanya. Stesen di mana?",
        "en": "Excuse me, where's the station?"
      },
      {
        "id": "ms-c07-s02",
        "speaker": "Kak Siti",
        "ms": "Encik jalan terus, kemudian belok kanan di lampu isyarat.",
        "en": "Go straight on, then turn right at the traffic lights."
      },
      {
        "id": "ms-c07-s03",
        "speaker": "Tanaka",
        "ms": "Jauhkah dari sini?",
        "en": "Is it far from here?"
      },
      {
        "id": "ms-c07-s04",
        "speaker": "Kak Siti",
        "ms": "Tidak jauh. Lebih kurang lima ratus meter. Jalan kaki lebih kurang sepuluh minit.",
        "en": "Not far. About 500 m, about ten minutes on foot."
      },
      {
        "id": "ms-c07-s05",
        "speaker": "Tanaka",
        "ms": "Stesen itu di sebelah bank?",
        "en": "Is the station next to the bank?"
      },
      {
        "id": "ms-c07-s06",
        "speaker": "Kak Siti",
        "ms": "Bukan. Stesen itu di depan bank, di sebelah kedai kopi.",
        "en": "No. It's in front of the bank, next to the coffee shop."
      },
      {
        "id": "ms-c07-s07",
        "speaker": "Tanaka",
        "ms": "Terima kasih banyak!",
        "en": "Thank you very much!"
      },
      {
        "id": "ms-c07-s08",
        "speaker": "Kak Siti",
        "ms": "Sama-sama. Hati-hati!",
        "en": "You're welcome. Take care!"
      },
      {
        "id": "ms-c07-s09",
        "speaker": "(Later, in a taxi)",
        "ms": "Pemandu: Encik mahu pergi ke mana?",
        "en": "Where would you like to go?"
      },
      {
        "id": "ms-c07-s10",
        "speaker": "Tanaka",
        "ms": "Ke pejabat. Berapa lama?",
        "en": "To the office. How long will it take?"
      },
      {
        "id": "ms-c07-s11",
        "speaker": "Pemandu",
        "ms": "Lebih kurang dua puluh minit, kalau tidak sesak.",
        "en": "About twenty minutes, if there is no traffic jam."
      },
      {
        "id": "ms-c07-s12",
        "speaker": "Tanaka",
        "ms": "Saya turun di depan pintu masuk, ya.",
        "en": "I'll get off in front of the entrance."
      },
      {
        "id": "ms-c07-s13",
        "speaker": "Pemandu",
        "ms": "Boleh, encik.",
        "en": "Sure."
      }
    ]
  },
