  "scenario": {
    "title_en": "Sudah makan?",
    "title_ja": "もう食べた？",
    "lines": [
      {
        "id": "ms-c04-s01",
        "speaker": "Encik Rahman",
        "ms": "Encik Tanaka, sudah makan?",
        "en": "Mr Tanaka, have you eaten?"
      },
      {
        "id": "ms-c04-s02",
        "speaker": "Tanaka",
        "ms": "Belum. Saya masih ada kerja.",
        "en": "Not yet. I still have work."
      },
      {
        "id": "ms-c04-s03",
        "speaker": "Encik Rahman",
        "ms": "Sekarang pukul satu suku. Jom makan!",
        "en": "It's a quarter past one. Let's eat!"
      },
      {
        "id": "ms-c04-s04",
        "speaker": "Tanaka",
        "ms": "Baik. Mesyuarat kita pukul berapa?",
        "en": "Okay. What time is our meeting?"
      },
      {
        "id": "ms-c04-s05",
        "speaker": "Encik Rahman",
        "ms": "Mesyuarat akan mula pukul tiga petang.",
        "en": "The meeting starts at 3 p.m."
      },
      {
        "id": "ms-c04-s06",
        "speaker": "Tanaka",
        "ms": "Saya biasanya makan di kedai mamak. Encik pula?",
        "en": "I usually eat at a mamak shop. And you?"
      },
      {
        "id": "ms-c04-s07",
        "speaker": "Encik Rahman",
        "ms": "Saya kadang-kadang makan di sana. Setiap Jumaat saya makan nasi kandar.",
        "en": "Sometimes I eat there. Every Friday I have nasi kandar."
      },
      {
        "id": "ms-c04-s08",
        "speaker": "Tanaka",
        "ms": "Saya belum pernah makan nasi kandar!",
        "en": "I've never had nasi kandar!"
      },
      {
        "id": "ms-c04-s09",
        "speaker": "Encik Rahman",
        "ms": "Jom, hari ini kita makan nasi kandar!",
        "en": "Come on, today we'll have nasi kandar!"
      },
      {
        "id": "ms-c04-s10",
        "speaker": "(Phone, 1:15 p.m.)",
        "ms": "Puan Aini: Encik Tanaka sedang makan. Dia akan balik pukul dua.",
        "en": "Mr Tanaka is having lunch. He'll be back at 2."
      }
    ]
  },
