  "frames": [
    {
      "id": "ms-c13-f01",
      "frame": "Saya belum ___.",
      "example": "Saya belum makan.",
      "meaning_en": "I haven't eaten yet.",
      "meaning_ja": "まだ食べていません。"
    },
    {
      "id": "ms-c13-f02",
      "frame": "Bolehkah saya ___?",
      "example": "Bolehkah saya masuk?",
      "meaning_en": "May I come in?",
      "meaning_ja": "入ってもよろしいですか。"
    },
    {
      "id": "ms-c13-f03",
      "frame": "Saya perlu ___.",
      "example": "Saya perlu berjumpa doktor.",
      "meaning_en": "I need to see a doctor.",
      "meaning_ja": "医者に会う必要があります。"
    },
    {
      "id": "ms-c13-f04",
      "frame": "Encik patut ___.",
      "example": "Encik patut berehat.",
      "meaning_en": "You should rest.",
      "meaning_ja": "休んだほうがいいですよ。"
    },
    {
      "id": "ms-c13-f05",
      "frame": "Tidak dibenarkan ___ di sini.",
      "example": "Tidak dibenarkan minum di sini.",
      "meaning_en": "Drinking is not allowed here.",
      "meaning_ja": "ここでは飲むことは許可されていません。"
    },
    {
      "id": "ms-c13-f06",
      "frame": "Wajib ___ borang ini.",
      "example": "Wajib isi borang ini.",
      "meaning_en": "You must fill in this form.",
      "meaning_ja": "この用紙への記入は必須です。"
    }
  ],
  "scenario": {
    "title_en": "At the clinic and the pharmacy",
    "title_ja": "クリニックと薬局で",
    "lines": [
      {
        "id": "ms-c13-s01",
        "speaker": "Penyambut tetamu",
        "ms": "Selamat pagi, encik. Ada temu janji?",
        "en": "Good morning, sir. Do you have an appointment?"
      },
      {
        "id": "ms-c13-s02",
        "speaker": "Tanaka",
        "ms": "Tidak ada. Saya demam dan sakit tekak. Saya batuk juga.",
        "en": "No. I have a fever and a sore throat. I'm coughing too."
      },
      {
        "id": "ms-c13-s03",
        "speaker": "Penyambut tetamu",
        "ms": "Encik perlu daftar dulu. Wajib isi borang ini.",
        "en": "You need to register first. You must fill in this form."
      },
      {
        "id": "ms-c13-s04",
        "speaker": "Tanaka",
        "ms": "Baik. Saya belum isi borang. Bolehkah saya isi borang di sini?",
        "en": "Okay. I haven't filled in the form yet. May I fill it in here?"
      },
      {
        "id": "ms-c13-s05",
        "speaker": "Penyambut tetamu",
        "ms": "Boleh. Ini klinik panel syarikat encik?",
        "en": "Yes. Is this your company's panel clinic?"
      },
      {
        "id": "ms-c13-s06",
        "speaker": "Tanaka",
        "ms": "Ya. Boleh saya minum air di sini?",
        "en": "Yes. Can I drink water here?"
      },
      {
        "id": "ms-c13-s07",
        "speaker": "Penyambut tetamu",
        "ms": "Maaf, tidak dibenarkan minum di sini. Dilarang makan dan minum di bilik menunggu.",
        "en": "Sorry, drinking isn't allowed here. No eating or drinking in the waiting room."
      },
      {
        "id": "ms-c13-s08",
        "speaker": "Tanaka",
        "ms": "Baik, saya faham. Terima kasih.",
        "en": "Okay, I understand. Thank you."
      },
      {
        "id": "ms-c13-s09",
        "speaker": "Penyambut tetamu",
        "ms": "Encik ada alahan?",
        "en": "Do you have any allergies?"
      },
      {
        "id": "ms-c13-s10",
        "speaker": "Tanaka",
        "ms": "Tidak. Saya tidak ada alahan.",
        "en": "No. I don't have any allergies."
      },
      {
        "id": "ms-c13-s11",
        "speaker": "Doktor",
        "ms": "Encik patut berehat di rumah. Encik tidak perlu datang ke pejabat esok.",
        "en": "You should rest at home. You don't need to come to the office tomorrow."
      },
      {
        "id": "ms-c13-s12",
        "speaker": "Tanaka",
        "ms": "Doktor, boleh saya minta cuti sakit untuk esok?",
        "en": "Doctor, may I ask for sick leave for tomorrow?"
      },
      {
        "id": "ms-c13-s13",
        "speaker": "Doktor",
        "ms": "Boleh. Saya bagi cuti sakit satu hari.",
        "en": "Yes. I'll give you one day of sick leave."
      },
      {
        "id": "ms-c13-s14",
        "speaker": "Tanaka",
        "ms": "Terima kasih, doktor.",
        "en": "Thank you, doctor."
      },
      {
        "id": "ms-c13-s15",
        "speaker": "Tanaka",
        "ms": "Maaf, boleh cakap lagi sekali? Saya tidak faham arahan itu.",
        "en": "Sorry, could you say that once more? I don't understand that instruction."
      },
      {
        "id": "ms-c13-s16",
        "speaker": "Ahli farmasi",
        "ms": "Boleh. Encik mesti baca arahan di label. Dos ada di label itu.",
        "en": "Of course. You must read the instructions on the label. The dose is on the label."
      },
      {
        "id": "ms-c13-s17",
        "speaker": "Tanaka",
        "ms": "Baik, saya baca label itu. Terima kasih.",
        "en": "Okay, I'll read the label. Thank you."
      },
      {
        "id": "ms-c13-s18",
        "speaker": "Ahli farmasi",
        "ms": "Sama-sama. Kalau ada soalan, tanya saya lagi.",
        "en": "You're welcome. If you have a question, ask me again."
      }
    ]
  },
