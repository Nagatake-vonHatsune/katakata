  "frames": [
    {
      "id": "ms-c15-f01",
      "frame": "Saya mencari ___ yang ada ___.",
      "example": "Saya mencari beg yang ada zip.",
      "meaning_en": "I'm looking for a bag that has a zip.",
      "meaning_ja": "ファスナー付きのバッグを探しています。"
    },
    {
      "id": "ms-c15-f02",
      "frame": "___ saya hilang.",
      "example": "Dompet saya hilang.",
      "meaning_en": "My wallet is lost.",
      "meaning_ja": "財布をなくしました。"
    },
    {
      "id": "ms-c15-f03",
      "frame": "Lelaki yang pakai ___.",
      "example": "Lelaki yang pakai cermin mata.",
      "meaning_en": "The man who wears glasses.",
      "meaning_ja": "眼鏡をかけている男性。"
    },
    {
      "id": "ms-c15-f04",
      "frame": "Beg itu warna ___ dan ada ___.",
      "example": "Beg itu warna hitam dan ada tali panjang.",
      "meaning_en": "The bag is black and has a long strap.",
      "meaning_ja": "そのバッグは黒で、長いひもが付いています。"
    },
    {
      "id": "ms-c15-f05",
      "frame": "Yang mana satu? Yang ___ atau yang ___?",
      "example": "Yang mana satu? Yang ada zip atau yang tidak ada zip?",
      "meaning_en": "Which one? The one with a zip or the one without?",
      "meaning_ja": "どれですか。ファスナー付きのですか、なしのですか。"
    },
    {
      "id": "ms-c15-f06",
      "frame": "Bentuknya ___, seperti ___.",
      "example": "Bentuknya segi empat, seperti kotak.",
      "meaning_en": "It is rectangular, like a box.",
      "meaning_ja": "形は四角で、箱のようです。"
    }
  ],
  "scenario": {
    "title_en": "A lost wallet and a visitor",
    "title_ja": "なくした財布と迎える客",
    "lines": [
      {
        "id": "ms-c15-s01",
        "speaker": "Tanaka",
        "ms": "Maaf, ini kaunter barang hilang? Saya mencari dompet saya.",
        "en": "Excuse me, is this the lost property counter? I'm looking for my wallet."
      },
      {
        "id": "ms-c15-s02",
        "speaker": "Kakitangan stesen",
        "ms": "Ya, encik. Dompet yang mana? Apa warna dompet itu?",
        "en": "Yes, sir. Which wallet? What colour is it?"
      },
      {
        "id": "ms-c15-s03",
        "speaker": "Tanaka",
        "ms": "Hitam. Dompet kulit. Ada zip dan satu poket kecil.",
        "en": "Black. A leather wallet. It has a zip and one small pocket."
      },
      {
        "id": "ms-c15-s04",
        "speaker": "Kakitangan stesen",
        "ms": "Ada jenama?",
        "en": "Is there a brand?"
      },
      {
        "id": "ms-c15-s05",
        "speaker": "Tanaka",
        "ms": "Saya tidak ingat jenamanya. Bentuknya segi empat, seperti kotak kecil.",
        "en": "I don't remember the brand. It's rectangular, like a small box."
      },
      {
        "id": "ms-c15-s06",
        "speaker": "Kakitangan stesen",
        "ms": "Ada dua dompet hitam di sini. Yang mana satu? Yang ada zip atau yang tidak ada zip?",
        "en": "There are two black wallets here. Which one? The one with a zip or the one without?"
      },
      {
        "id": "ms-c15-s07",
        "speaker": "Tanaka",
        "ms": "Yang ada zip, seperti itu. Kad saya ada di dalam, tetapi pasport saya tidak ada.",
        "en": "The one with a zip, like that one. My card is inside, but my passport isn't."
      },
      {
        "id": "ms-c15-s08",
        "speaker": "Kakitangan stesen",
        "ms": "Betul, ada kad encik di dalam. Ini dompet encik.",
        "en": "That's right, your card is inside. Here is your wallet."
      },
      {
        "id": "ms-c15-s09",
        "speaker": "Tanaka",
        "ms": "Terima kasih banyak!",
        "en": "Thank you very much!"
      },
      {
        "id": "ms-c15-s10",
        "speaker": "Tanaka",
        "ms": "Encik Rahman, tetamu dari Jepun sudah sampai di stesen.",
        "en": "Mr Rahman, our guest from Japan has arrived at the station."
      },
      {
        "id": "ms-c15-s11",
        "speaker": "Encik Rahman",
        "ms": "Saya tidak tahu siapa dia. Lelaki yang mana?",
        "en": "I don't know who he is. Which man?"
      },
      {
        "id": "ms-c15-s12",
        "speaker": "Tanaka",
        "ms": "Lelaki yang pakai cermin mata dan baju berjalur. Dia dengan seorang perempuan yang pakai topi. Mereka bawa beg yang ada tali panjang.",
        "en": "The man who wears glasses and a striped shirt. He's with a woman who wears a hat. They're carrying a bag with a long strap."
      },
      {
        "id": "ms-c15-s13",
        "speaker": "Encik Rahman",
        "ms": "Dia di mana sekarang?",
        "en": "Where is he now?"
      },
      {
        "id": "ms-c15-s14",
        "speaker": "Tanaka",
        "ms": "Dia dekat kaunter, di sebelah lif.",
        "en": "He's near the counter, next to the lift."
      },
      {
        "id": "ms-c15-s15",
        "speaker": "Encik Rahman",
        "ms": "Oh, saya sudah jumpa dia.",
        "en": "Oh, I've found him."
      }
    ]
  },
