      "example": "Tolong simpankan bungkusan ini.",
      "meaning_en": "Please keep this parcel for me.",
      "meaning_ja": "この荷物を預かってください。"
    },
    {
      "id": "ms-c12-f02",
      "frame": "Boleh ___ mesej itu?",
      "example": "Boleh tunjukkan mesej itu?",
      "meaning_en": "Can you show me the message?",
      "meaning_ja": "そのメッセージを見せてもらえますか。"
    },
    {
      "id": "ms-c12-f03",
      "frame": "Saya mahu ambil ___. Sudah sampai?",
      "example": "Saya mahu ambil bungkusan. Sudah sampai?",
      "meaning_en": "I'd like to collect my parcel. Has it arrived?",
      "meaning_ja": "荷物を受け取りたいのですが。もう届いていますか。"
    },
