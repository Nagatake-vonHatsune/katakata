  "scenario": {
    "title_en": "Parcels and a leak",
    "title_ja": "荷物の受け取りと水漏れ",
    "lines": [
      {
        "id": "ms-c12-s01",
        "speaker": "Tanaka",
        "ms": "Selamat petang. Saya mahu ambil bungkusan. Sudah sampai?",
        "en": "Good afternoon. I'd like to collect a parcel. Has it arrived?"
      },
      {
        "id": "ms-c12-s02",
        "speaker": "Pengawal",
        "ms": "Sudah, encik. Unit berapa?",
        "en": "Yes, sir. Which unit?"
      },
      {
        "id": "ms-c12-s03",
        "speaker": "Tanaka",
        "ms": "Blok B, unit 12-3.",
        "en": "Block B, unit 12-3."
      },
      {
        "id": "ms-c12-s04",
        "speaker": "Pengawal",
        "ms": "Ada dua bungkusan. Boleh tunjukkan mesej itu?",
        "en": "There are two parcels. Can you show me the message?"
      },
      {
        "id": "ms-c12-s05",
        "speaker": "Tanaka",
        "ms": "Boleh. Nombor penjejakan ada dalam mesej ini.",
        "en": "Sure. The tracking number is in this message."
      },
      {
        "id": "ms-c12-s06",
        "speaker": "Pengawal",
        "ms": "Terima kasih. Bungkusan besar ini untuk encik. Bungkusan kecil itu bukan untuk encik. Label ini koyak, tetapi nombor unit ada di sini: Blok A, unit 8-1.",
        "en": "Thank you. This big parcel is for you. That small parcel is not for you. The label is torn, but the unit number is here: Block A, unit 8-1."
      },
      {
        "id": "ms-c12-s07",
        "speaker": "Tanaka",
        "ms": "Oh, bukan untuk saya. Boleh tolong hantarkan bungkusan kecil itu ke unit 8-1?",
        "en": "Oh, it's not mine. Could you please deliver that small parcel to unit 8-1?"
      },
      {
        "id": "ms-c12-s08",
        "speaker": "Pengawal",
        "ms": "Pemilik unit itu belum ada di rumah. Saya simpankan bungkusan itu di pondok pengawal dulu.",
        "en": "The owner of that unit isn't home yet. I'll keep the parcel in the guardhouse for now."
      },
      {
        "id": "ms-c12-s09",
        "speaker": "Tanaka",
        "ms": "Baik. Tolong hubungi pemilik unit itu nanti. Saya bawa bungkusan besar ini ke atas.",
        "en": "Fine. Please contact the owner of that unit later. I'll take this big parcel upstairs."
      },
      {
        "id": "ms-c12-s10",
        "speaker": "Pengawal",
        "ms": "Baik, encik. Selamat petang!",
        "en": "Fine, sir. Good afternoon!"
      },
      {
        "id": "ms-c12-s11",
        "speaker": "Tanaka",
        "ms": "Selamat pagi. Saya Tanaka, Blok B, unit 12-3. Ada kebocoran di siling bilik air saya.",
        "en": "Good morning. This is Tanaka, Block B, unit 12-3. There's a leak in my bathroom ceiling."
      },
      {
        "id": "ms-c12-s12",
        "speaker": "Pejabat pengurusan",
        "ms": "Selamat pagi, Encik Tanaka. Air turun dari siling atau dari paip?",
        "en": "Good morning, Mr Tanaka. Is the water coming from the ceiling or from a pipe?"
      },
      {
        "id": "ms-c12-s13",
        "speaker": "Tanaka",
        "ms": "Dari siling, dekat lampu. Saya takut lampu itu rosak.",
        "en": "From the ceiling, near the light. I'm afraid the light is damaged."
      },
      {
        "id": "ms-c12-s14",
        "speaker": "Pejabat pengurusan",
        "ms": "Tolong matikan lampu itu dulu. Kami akan menghubungi juruteknik.",
        "en": "Please switch that light off first. We'll contact a technician."
      },
      {
        "id": "ms-c12-s15",
        "speaker": "Tanaka",
        "ms": "Baik, saya matikan lampu itu sekarang. Bila juruteknik boleh datang?",
        "en": "Okay, I'm switching the light off now. When can the technician come?"
      },
      {
        "id": "ms-c12-s16",
        "speaker": "Pejabat pengurusan",
        "ms": "Ada slot petang ini, pukul tiga. Boleh?",
        "en": "There's a slot this afternoon at three. Is that all right?"
      },
      {
        "id": "ms-c12-s17",
        "speaker": "Tanaka",
        "ms": "Boleh. Tolong hubungi saya sebelum juruteknik sampai.",
        "en": "That's fine. Please contact me before the technician arrives."
      },
      {
        "id": "ms-c12-s18",
        "speaker": "Pejabat pengurusan",
        "ms": "Baik. Juruteknik akan melihat siling itu. Saya isi borang aduan sekarang.",
        "en": "Okay. The technician will look at the ceiling. I'm filling in the complaint form now."
      },
      {
        "id": "ms-c12-s19",
        "speaker": "Tanaka",
        "ms": "Terima kasih. Saya tunggu di rumah.",
        "en": "Thank you. I'll wait at home."
      }
    ]
  },
