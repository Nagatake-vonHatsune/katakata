  "frames": [
    {
      "id": "ms-c02-f01",
      "frame": "Nama saya ___.",
      "example": "Nama saya Tanaka.",
      "meaning_en": "My name is Tanaka.",
      "meaning_ja": "私の名前は田中です。"
    },
    {
      "id": "ms-c02-f02",
      "frame": "Siapa nama (title)?",
      "example": "Siapa nama encik?",
      "meaning_en": "What is your name, sir?",
      "meaning_ja": "お名前は何ですか。"
    },
    {
      "id": "ms-c02-f03",
      "frame": "Saya orang ___. Asal saya dari ___.",
      "example": "Saya orang Jepun. Asal saya dari Osaka.",
      "meaning_en": "I'm Japanese. I'm originally from Osaka.",
      "meaning_ja": "私は日本人です。大阪出身です。"
    },
    {
      "id": "ms-c02-f04",
      "frame": "Saya kerja di ___. Saya (job / pe- word).",
      "example": "Saya kerja di syarikat Jepun. Saya jurutera.",
      "meaning_en": "I work at a Japanese company. I'm an engineer.",
      "meaning_ja": "日本の会社で働いています。エンジニアです。"
    },
    {
      "id": "ms-c02-f05",
      "frame": "Saya belajar di ___.",
      "example": "Saya belajar di Universiti Malaya.",
      "meaning_en": "I study at Universiti Malaya.",
      "meaning_ja": "マラヤ大学で勉強しています。"
    },
    {
      "id": "ms-c02-f06",
      "frame": "Saya tinggal di ___.",
      "example": "Saya tinggal di Mont Kiara.",
      "meaning_en": "I live in Mont Kiara.",
      "meaning_ja": "モントキアラに住んでいます。"
    },
    {
      "id": "ms-c02-f07",
      "frame": "Hobi saya ___. / Saya suka ___.",
      "example": "Hobi saya badminton. Saya suka masakan Malaysia.",
      "meaning_en": "My hobby is badminton. I like Malaysian food.",
      "meaning_ja": "趣味はバドミントンです。マレーシア料理が好きです。"
    },
    {
      "id": "ms-c02-f08",
      "frame": "Di manakah ___?",
      "example": "Di manakah pejabat encik?",
      "meaning_en": "Where is your office?",
      "meaning_ja": "あなたのオフィスはどこですか。"
    }
  ],
  "scenario": {
    "title_en": "Meeting the team",
    "title_ja": "チームとの顔合わせ",
    "lines": [
      {
        "id": "ms-c02-s01",
        "speaker": "Encik Rahman",
        "ms": "Selamat pagi. Nama saya Rahman. Saya pengurus di pejabat ini. Siapa nama encik?",
        "en": "Good morning. I'm Rahman, the manager here. What's your name?"
      },
      {
        "id": "ms-c02-s02",
        "speaker": "Tanaka",
        "ms": "Nama saya Tanaka. Saya orang Jepun.",
        "en": "My name is Tanaka. I'm Japanese."
      },
      {
        "id": "ms-c02-s03",
        "speaker": "Encik Rahman",
        "ms": "Kampung encik di mana?",
        "en": "Where is your hometown?"
      },
      {
        "id": "ms-c02-s04",
        "speaker": "Tanaka",
        "ms": "Asal saya dari Osaka. Kampung saya di Osaka.",
        "en": "I'm from Osaka. My hometown is Osaka."
      },
      {
        "id": "ms-c02-s05",
        "speaker": "Cik Mei Ling",
        "ms": "Encik tinggal di mana?",
        "en": "Where do you live?"
      },
      {
        "id": "ms-c02-s06",
        "speaker": "Tanaka",
        "ms": "Saya tinggal di Mont Kiara. Cik Mei Ling pula?",
        "en": "I live in Mont Kiara. And you?"
      },
      {
        "id": "ms-c02-s07",
        "speaker": "Cik Mei Ling",
        "ms": "Saya tinggal di Petaling Jaya.",
        "en": "I live in Petaling Jaya."
      },
      {
        "id": "ms-c02-s08",
        "speaker": "Cik Mei Ling",
        "ms": "Apa hobi encik?",
        "en": "What's your hobby?"
      },
      {
        "id": "ms-c02-s09",
        "speaker": "Tanaka",
        "ms": "Hobi saya badminton. Saya juga suka masakan Malaysia.",
        "en": "My hobby is badminton. I also like Malaysian food."
      },
      {
