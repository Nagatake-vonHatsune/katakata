  "scenario": {
    "title_en": "At the mamak",
    "title_ja": "ママッ（食堂）で",
    "lines": [
      {
        "id": "ms-c05-s01",
        "speaker": "Abang Rashid",
        "ms": "Selamat petang! Encik mahu minum apa?",
        "en": "Good afternoon! What would you like to drink?"
      },
      {
        "id": "ms-c05-s02",
        "speaker": "Tanaka",
        "ms": "Saya mahu teh tarik, kurang manis.",
        "en": "I'd like teh tarik, less sweet."
      },
      {
        "id": "ms-c05-s03",
        "speaker": "Abang Rashid",
        "ms": "Panas atau sejuk?",
        "en": "Hot or cold?"
      },
      {
        "id": "ms-c05-s04",
        "speaker": "Tanaka",
        "ms": "Sejuk. Ais sedikit.",
        "en": "Cold. A little ice."
      },
      {
        "id": "ms-c05-s05",
        "speaker": "Abang Rashid",
        "ms": "Makan?",
        "en": "Anything to eat?"
      },
      {
        "id": "ms-c05-s06",
        "speaker": "Tanaka",
        "ms": "Nasi lemak satu. Sambalnya pedas?",
        "en": "One nasi lemak. Is the sambal spicy?"
      },
      {
        "id": "ms-c05-s07",
        "speaker": "Abang Rashid",
        "ms": "Pedas sedikit, tapi sedap!",
        "en": "A little spicy, but delicious!"
      },
      {
        "id": "ms-c05-s08",
        "speaker": "(Later)",
        "ms": "Abang Rashid: Macam mana? Sedap?",
        "en": "How is it? Good?"
      },
      {
        "id": "ms-c05-s09",
        "speaker": "Tanaka",
        "ms": "Sedap! Tapi pedas. Saya rasa panas!",
        "en": "Delicious! But spicy. I feel hot!"
      },
      {
        "id": "ms-c05-s10",
        "speaker": "Abang Rashid",
        "ms": "Ini air kosong.",
        "en": "Here's some plain water."
      },
      {
        "id": "ms-c05-s11",
        "speaker": "Tanaka",
        "ms": "Terima kasih, abang. Saya kenyang!",
        "en": "Thanks. I'm full!"
      }
    ]
  },
