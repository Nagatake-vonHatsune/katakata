  "frames": [
    {
      "id": "ms-c06-f01",
      "frame": "A lebih ___ daripada B.",
      "example": "Kondo A lebih besar daripada kondo B.",
      "meaning_en": "Condo A is bigger than condo B.",
      "meaning_ja": "コンドAはコンドBより大きいです。"
    },
    {
      "id": "ms-c06-f02",
      "frame": "A kurang ___ daripada B.",
      "example": "Kondo B kurang mahal daripada kondo A.",
      "meaning_en": "Condo B is less expensive than condo A.",
      "meaning_ja": "コンドBはコンドAほど高くないです。"
    },
    {
      "id": "ms-c06-f03",
      "frame": "A sama ___ dengan B. / A setinggi / semahal B.",
      "example": "Kondo D semahal kondo A.",
      "meaning_en": "Condo D is as expensive as condo A.",
      "meaning_ja": "コンドDはコンドAと同じくらい高いです。"
    },
    {
      "id": "ms-c06-f04",
      "frame": "___ paling ___. / ___ termurah / terbesar / terbaik / tercantik.",
      "example": "Kondo C paling murah. Kondo C termurah.",
      "meaning_en": "Condo C is the cheapest.",
      "meaning_ja": "コンドCが一番安いです。"
    },
    {
      "id": "ms-c06-f05",
      "frame": "Yang mana lebih ___?",
      "example": "Yang mana lebih selesa?",
      "meaning_en": "Which one is more comfortable?",
      "meaning_ja": "どちらのほうが快適ですか。"
    },
    {
      "id": "ms-c06-f06",
      "frame": "___ ini terlalu ___.",
      "example": "Kondo ini terlalu bising.",
      "meaning_en": "This condo is too noisy.",
      "meaning_ja": "このコンドはうるさすぎます。"
    },
    {
      "id": "ms-c06-f07",
      "frame": "Saya pilih ___.",
      "example": "Saya pilih kondo D.",
      "meaning_en": "I choose condo D.",
      "meaning_ja": "コンドDを選びます。"
    }
  ],
  "scenario": {
    "title_en": "Choosing a condo",
    "title_ja": "コンドミニアム選び",
    "lines": [
      {
        "id": "ms-c06-s01",
        "speaker": "Cik Mei Ling",
        "ms": "Encik Tanaka, encik suka kondo yang mana?",
        "en": "Which condo do you like?"
      },
      {
        "id": "ms-c06-s02",
        "speaker": "Tanaka",
        "ms": "Kondo A lebih besar daripada kondo B, tetapi kondo A lebih mahal.",
        "en": "Condo A is bigger than B, but A is more expensive."
      },
      {
        "id": "ms-c06-s03",
        "speaker": "Cik Mei Ling",
        "ms": "Kondo B kurang besar, tetapi sewanya lebih murah.",
        "en": "Condo B is less big, but its rent is cheaper."
      },
      {
        "id": "ms-c06-s04",
        "speaker": "Tanaka",
        "ms": "Kondo C pula?",
        "en": "What about condo C?"
      },
      {
        "id": "ms-c06-s05",
        "speaker": "Cik Mei Ling",
        "ms": "Kondo C paling murah, tetapi terlalu bising.",
        "en": "Condo C is the cheapest, but too noisy."
      },
      {
        "id": "ms-c06-s06",
        "speaker": "Tanaka",
        "ms": "Sewa kondo A dan kondo D sama?",
        "en": "Are the rents of condo A and condo D the same?"
      },
      {
        "id": "ms-c06-s07",
        "speaker": "Cik Mei Ling",
        "ms": "Ya. Kondo D semahal kondo A, tetapi kondo D paling baru, ada tiga bilik dan sangat luas.",
        "en": "Yes. D is as expensive as A, but D is the newest, has three rooms and is very spacious."
      },
      {
        "id": "ms-c06-s08",
        "speaker": "Tanaka",
        "ms": "Kondo D yang terbaik! Saya pilih kondo D.",
        "en": "Condo D is the best! I'll choose D."
      }
    ]
  },
