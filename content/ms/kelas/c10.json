  "scenario": {
    "title_en": "A working day and a new neighbour",
    "title_ja": "いつもの一日と新しいお隣さん",
    "lines": [
      {
        "id": "ms-c10-s01",
        "speaker": "Puan Aini",
        "ms": "Selamat pagi, Encik Tanaka! Biasanya pukul berapa encik bertolak ke pejabat?",
        "en": "Good morning, Mr Tanaka! What time do you usually set off for the office?"
      },
      {
        "id": "ms-c10-s02",
        "speaker": "Tanaka",
        "ms": "Saya bertolak pukul tujuh. Saya naik bas. Bas itu berhenti di depan pejabat.",
        "en": "I set off at seven. I take the bus. It stops in front of the office."
      },
      {
        "id": "ms-c10-s03",
        "speaker": "Puan Aini",
        "ms": "Encik bersarapan di rumah?",
        "en": "Do you have breakfast at home?"
      },
      {
        "id": "ms-c10-s04",
        "speaker": "Tanaka",
        "ms": "Tidak. Saya bersarapan di kedai mamak dekat pejabat.",
        "en": "No. I have breakfast at the mamak near the office."
      },
      {
        "id": "ms-c10-s05",
        "speaker": "Puan Aini",
        "ms": "Pada hujung minggu pula, encik buat apa?",
        "en": "And at the weekend, what do you do?"
      },
      {
        "id": "ms-c10-s06",
        "speaker": "Tanaka",
        "ms": "Pada hari Sabtu saya berenang. Pada hari Ahad saya berbasikal dengan kawan.",
        "en": "On Saturday I swim. On Sunday I go cycling with a friend."
      },
      {
        "id": "ms-c10-s07",
        "speaker": "Puan Aini",
        "ms": "Wah, encik selalu bersenam! Saya pula suka berehat di rumah.",
        "en": "Wow, you exercise a lot! Me, I like to rest at home."
      },
      {
        "id": "ms-c10-s08",
        "speaker": "Tanaka",
        "ms": "Itu pun bagus!",
        "en": "That's good too!"
      },
      {
        "id": "ms-c10-s09",
        "speaker": "Puan Aini",
        "ms": "Oh, sudah pukul sembilan. Mesyuarat kita bermula sekarang!",
        "en": "Oh, it's nine already. Our meeting starts now!"
      },
      {
        "id": "ms-c10-s10",
        "speaker": "Puan Siti",
        "ms": "Selamat petang. Encik jiran baru, ya?",
        "en": "Good evening. You're the new neighbour, aren't you?"
      },
      {
        "id": "ms-c10-s11",
        "speaker": "Tanaka",
        "ms": "Ya, saya baru berpindah minggu lepas. Nama saya Tanaka. Saya berasal dari Osaka.",
        "en": "Yes, I moved in last week. My name is Tanaka. I'm from Osaka."
      },
      {
        "id": "ms-c10-s12",
        "speaker": "Puan Siti",
        "ms": "Selamat berkenalan! Saya Siti. Encik bekerja di mana?",
        "en": "Nice to meet you! I'm Siti. Where do you work?"
      },
      {
        "id": "ms-c10-s13",
        "speaker": "Tanaka",
        "ms": "Saya bekerja di sebuah syarikat Jepun di Kuala Lumpur. Puan pula?",
        "en": "I work at a Japanese company in Kuala Lumpur. And you?"
      },
      {
        "id": "ms-c10-s14",
        "speaker": "Puan Siti",
        "ms": "Saya berniaga. Saya ada kedai kek dekat stesen.",
        "en": "I run a business. I have a cake shop near the station."
      },
      {
        "id": "ms-c10-s15",
        "speaker": "Tanaka",
        "ms": "Puan sudah lama tinggal di sini?",
        "en": "Have you lived here long?"
      },
      {
        "id": "ms-c10-s16",
        "speaker": "Puan Siti",
        "ms": "Sudah sepuluh tahun. Saya sudah berkahwin. Dua orang anak saya masih bersekolah.",
        "en": "Ten years now. I'm married. My two children are still at school."
      },
      {
        "id": "ms-c10-s17",
        "speaker": "Tanaka",
        "ms": "Saya pula tinggal berdua dengan isteri saya.",
        "en": "And I live with my wife, just the two of us."
      },
      {
        "id": "ms-c10-s18",
        "speaker": "Puan Siti",
        "ms": "Pada hari Ahad, kami berkumpul di rumah saya. Encik datang, ya!",
        "en": "On Sunday we're getting together at my place. Do come!"
      },
      {
        "id": "ms-c10-s19",
        "speaker": "Tanaka",
        "ms": "Baik, terima kasih! Nanti kita berbual lagi.",
        "en": "Sure, thank you! Let's chat again later."
      }
    ]
  },
