  "scenario": {
    "title_en": "The office jamuan",
    "title_ja": null,
    "lines": [
      {
        "id": "ms-c09-s01",
        "speaker": "Puan Aini",
        "ms": "Wah, banyak makanan! Kek ini dibuat oleh siapa?",
        "en": "Wow, so much food! Who made this cake?"
      },
      {
        "id": "ms-c09-s02",
        "speaker": "Tanaka",
        "ms": "Kek itu dibuat oleh isteri saya.",
        "en": "My wife made that cake."
      },
      {
        "id": "ms-c09-s03",
        "speaker": "Puan Aini",
        "ms": "Sedap sekali! Nasi lemak ini dibeli di mana?",
        "en": "Really delicious! Where was this nasi lemak bought?"
      },
      {
        "id": "ms-c09-s04",
        "speaker": "Encik Rahman",
        "ms": "Nasi lemak itu dibeli oleh Encik Tanaka pagi tadi.",
        "en": "Mr Tanaka bought it this morning."
      },
      {
        "id": "ms-c09-s05",
        "speaker": "Cik Mei Ling",
        "ms": "Teh tarik sudah diminum semua!",
        "en": "The teh tarik is all gone!"
      },
      {
        "id": "ms-c09-s06",
        "speaker": "Tanaka",
        "ms": "Durian ada?",
        "en": "Is there any durian?"
      },
      {
        "id": "ms-c09-s07",
        "speaker": "Puan Aini",
        "ms": "Tak ada. Durian dilarang di pejabat!",
        "en": "No. Durian is banned in the office!"
      },
      {
        "id": "ms-c09-s08",
        "speaker": "Encik Rahman",
        "ms": "Pejabat akan ditutup pukul enam. Jom kemas.",
        "en": "The office closes at six. Let's tidy up."
      },
      {
        "id": "ms-c09-s09",
        "speaker": "Tanaka",
        "ms": "Baik. Pinggan saya cuci.",
        "en": "Okay. I'll wash the plates."
      },
      {
        "id": "ms-c09-s10",
        "speaker": "Puan Aini",
        "ms": "Terima kasih, Encik Tanaka. Jumpa esok!",
        "en": "Thank you, Mr Tanaka. See you tomorrow!"
      }
    ]
  },
