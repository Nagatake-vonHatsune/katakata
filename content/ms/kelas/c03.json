  "frames": [
    {
      "id": "ms-c03-f01",
      "frame": "Berapa harga ___?",
      "example": "Berapa harga mangga ini?",
      "meaning_en": "How much are these mangoes?",
      "meaning_ja": "このマンゴーはいくらですか。"
    },
    {
      "id": "ms-c03-f02",
      "frame": "Harganya ___ ringgit (___ sen).",
      "example": "Harganya lapan ringgit lima puluh sen.",
      "meaning_en": "It's RM8.50.",
      "meaning_ja": "8リンギット50センです。"
    },
    {
      "id": "ms-c03-f03",
      "frame": "Berapa umur (title)? / Umur saya ___ tahun.",
      "example": "Umur saya tiga puluh lima tahun.",
      "meaning_en": "I'm 35 years old.",
      "meaning_ja": "私は35歳です。"
    },
    {
      "id": "ms-c03-f04",
      "frame": "Ini kali (ordinal) saya di ___.",
      "example": "Ini kali kedua saya di Malaysia.",
      "meaning_en": "This is my second time in Malaysia.",
      "meaning_ja": "マレーシアは今回が2回目です。"
    },
    {
      "id": "ms-c03-f05",
      "frame": "Diskaun ___ peratus.",
      "example": "Diskaun dua puluh peratus.",
      "meaning_en": "20% discount.",
      "meaning_ja": "20パーセント引きです。"
    },
    {
      "id": "ms-c03-f06",
      "frame": "Ketinggian ___ ___ meter.",
      "example": "Ketinggian bangunan ini tiga ratus meter.",
      "meaning_en": "This building is 300 metres tall.",
      "meaning_ja": "このビルの高さは300メートルです。"
    },
    {
      "id": "ms-c03-f07",
      "frame": "Nombor telefon saya ___.",
      "example": "Nombor telefon saya kosong satu dua...",
      "meaning_en": "My phone number is 012...",
      "meaning_ja": "私の電話番号は012…です。"
    }
  ],
  "scenario": {
    "title_en": "At the pasar malam",
    "title_ja": "パサール・マラム（夜市）で",
    "lines": [
      {
        "id": "ms-c03-s01",
        "speaker": "Tanaka",
        "ms": "Mak cik, berapa harga mangga ini?",
        "en": "Auntie, how much are these mangoes?"
      },
      {
        "id": "ms-c03-s02",
        "speaker": "Mak Cik Rosnah",
        "ms": "Satu kilo lapan ringgit.",
        "en": "Eight ringgit a kilo."
      },
      {
        "id": "ms-c03-s03",
        "speaker": "Tanaka",
        "ms": "Dua kilo berapa? Boleh diskaun?",
        "en": "How much for two kilos? Any discount?"
      },
      {
        "id": "ms-c03-s04",
        "speaker": "Mak Cik Rosnah",
        "ms": "Boleh. Dua kilo lima belas ringgit.",
        "en": "Sure. Two kilos for fifteen ringgit."
      },
      {
        "id": "ms-c03-s05",
        "speaker": "Tanaka",
        "ms": "Baik. Ini dua puluh ringgit.",
        "en": "Okay. Here's twenty ringgit."
      },
      {
        "id": "ms-c03-s06",
        "speaker": "Mak Cik Rosnah",
        "ms": "Baki lima ringgit. Ini kali pertama encik di pasar malam?",
        "en": "Your change is five ringgit. Is this your first time at a night market?"
      },
      {
        "id": "ms-c03-s07",
        "speaker": "Tanaka",
        "ms": "Bukan. Ini kali ketiga!",
        "en": "No. This is my third time!"
      },
      {
        "id": "ms-c03-s08",
        "speaker": "Mak Cik Rosnah",
        "ms": "Bagus! Terima kasih, encik.",
        "en": "Great! Thank you."
      },
      {
        "id": "ms-c03-s09",
        "speaker": "Tanaka",
        "ms": "Sama-sama, mak cik. Jumpa lagi!",
        "en": "You're welcome, auntie. See you again!"
      }
    ]
  },
